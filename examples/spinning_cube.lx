@module "main"

@use "std_math" as math
@use "std_libc" as libc
@use "std_memory" as mem
@use "std_string" as string
@use "std_termfx" as fx
@use "std_time" as time

let zBuffer: *f64;
let _buffer: *byte;

let cube_width: f64;
const width: i64 = 160;
const height: i64 = 50;

const distance_from_cam: i64 = 70;

const increment_speed: f64 = 0.6;
let horizontal_offset: f64;
const k1: f64 = 40.0;

const calculateX -> fn (i: i64, j: i64, k: i64, A: f64, B: f64, C: f64) f64 {
  let sA: f64 = libc::sin(A);
  let cA: f64 = libc::cos(A);
  let sB: f64 = libc::sin(B);
  let cB: f64 = libc::cos(B);
  let sC: f64 = libc::sin(C);
  let cC: f64 = libc::cos(C);

  return j * sA * sB * cC - k * cA * sB * cC +
         j * cA * sC + k * sA * sC + i * cB * cC;
}

const calculateY -> fn (i: i64, j: i64, k: i64, A: f64, B: f64, C: f64) f64 {
  let sA: f64 = libc::sin(A);
  let cA: f64 = libc::cos(A);
  let sB: f64 = libc::sin(B);
  let cB: f64 = libc::cos(B);
  let sC: f64 = libc::sin(C);
  let cC: f64 = libc::cos(C);

  return j * cA * cC + k * sA * cC -
         j * sA * sB * sC + k * cA * sB * sC -
         i * cB * sC;
}

const calculateZ -> fn (i: i64, j: i64, k: i64, A: f64, B: f64) f64 {
  let sA: f64 = libc::sin(A);
  let cA: f64 = libc::cos(A);
  let sB: f64 = libc::sin(B);
  let cB: f64 = libc::cos(B);

  return k * cA * cB - j * sA * cB + i * sB;
}

const calculateForSurface -> fn (cX: f64, cY: f64, cZ: f64,
                                ch: byte,
                                A: f64, B: f64, C: f64) void {
  let x: f64 = calculateX(cast<i64>(cX), cast<i64>(cY), cast<i64>(cZ), A, B, C);
  let y: f64 = calculateY(cast<i64>(cX), cast<i64>(cY), cast<i64>(cZ), A, B, C);
  let z: f64 = calculateZ(cast<i64>(cX), cast<i64>(cY), cast<i64>(cZ), A, B) + distance_from_cam;

  if (z <= 0.001) { return; }

  let ooz: f64 = 1.0 / z;
  if (ooz > 1000.0 || ooz < -1000.0) { return; }

  let xp: i64 = cast<i64>(width / 2 + horizontal_offset + k1 * ooz * x * 2);
  let yp: i64 = cast<i64>(height / 2 + k1 * ooz * y);

  if (xp >= 0 && xp < width && yp >= 0 && yp < height) {
    let idx: i64 = xp + yp * width;
    if (ooz > zBuffer[idx]) {
      zBuffer[idx] = ooz;
      _buffer[idx] = ch;
    }
  }
}


const print_cube -> fn (A: f64, B: f64, C: f64) void {
  loop [cubeX: f64 = -cube_width](cubeX < cube_width) : (cubeX = cubeX + increment_speed) {
    loop [cubeY: f64 = -cube_width](cubeY < cube_width) : (cubeY = cubeY + increment_speed) {
      calculateForSurface(cubeX,       cubeY,       -cube_width, '@', A, B, C);
      calculateForSurface(cube_width,  cubeY,       cubeX,       '+', A, B, C);
      calculateForSurface(-cube_width, cubeY,       -cubeX,      '~', A, B, C);
      calculateForSurface(-cubeX,      cubeY,       cube_width,  '#', A, B, C);
      calculateForSurface(cubeX,       -cube_width, -cubeY,      '*', A, B, C);
      calculateForSurface(cubeX,       cube_width,  cubeY,       '-', A, B, C);
    }
  }
}


pub const main -> fn () i64 {
  zBuffer = cast<*f64>(alloc(width * height * sizeof<f64>));
  _buffer = cast<*byte>(alloc(width * height));

  defer { free(zBuffer); free(_buffer); }

  let frame_count: i64 = 0;

  let A: f64 = 1.2;
  let B: f64 = 0.8;
  let C: f64 = 0.4;

  loop {
    mem::memset(cast<*void>(_buffer), 32, width * height);
    mem::memset(cast<*void>(zBuffer),  0, width * height * sizeof<f64>);

    cube_width = 10.0;
    horizontal_offset = -15.0;
    print_cube(A, B, C);  // Cube 1

    output(fx::CURSOR_HOME);
    loop [k: i64 = 0](k < width * height) : (++k) {
      if (k % width == 0) { output("\n"); }
      output(string::from_byte(_buffer[k]));
    }

    output(fx::move_cursor(1, 29), " Frame: ", frame_count, " ");

    // Rotate cube
    A = libc::fmod(A + 0.05, math::TWO_PI);
    B = libc::fmod(B + 0.05, math::TWO_PI);
    C = libc::fmod(C + 0.01, math::TWO_PI);

    // Increment frame count
    ++frame_count;

    time::usleep(20000);
  }

  return 0;
}
